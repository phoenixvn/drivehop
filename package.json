{
  "name": "multicloud",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local-only dashboard for several cloud storage accounts with cross-account copy/move.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @multicloud/server",
    "dev:web": "npm run dev -w @multicloud/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:desktop": "node scripts/build-desktop.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^7.0.2"
  }
}
