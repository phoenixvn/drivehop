{
  "name": "@multicloud/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8799",
    "types": "wrangler types --strict-vars false",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@multicloud/core": "*",
    "@multicloud/shared": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
