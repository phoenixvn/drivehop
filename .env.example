# Copy to .env and fill in. Never commit .env.
# OAuth 2.0 client (type "Web application") from Google Cloud Console.
# Authorized redirect URI: http://localhost:8787/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API server port and the origin of the web UI. WEB_ORIGIN also sets the port the web UI
# runs on: if 5173 is taken by another app, change it here (e.g. http://localhost:5174).
PORT=8787
WEB_ORIGIN=http://localhost:5173

# Optional. Base64 of 32 random bytes. Used to encrypt stored tokens ONLY if the OS keyring
# (Windows Credential Manager) is unavailable. Leave empty to use the keyring.
MULTICLOUD_MASTER_KEY=

# Where the SQLite database and other local state live.
DATA_DIR=./data
